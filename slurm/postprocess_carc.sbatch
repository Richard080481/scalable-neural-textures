#!/bin/bash
# Submit with RUN1, RUN2, RUN4, OPT_BASE, and OPT_NOSYNC exported.
# This CPU-only job builds a GitHub-ready result bundle after GPU runs finish.
#SBATCH --job-name=nt-plots
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=00:30:00
#SBATCH --output=outputs/slurm-%x-%j.out

set -euo pipefail
module purge
module load conda
eval "$(conda shell.bash hook)"
: "${NT_ENV:=$HOME/.conda/envs/scalable-neural-textures}"
conda activate "$NT_ENV"
cd "$SLURM_SUBMIT_DIR"

: "${RUN1:?Export RUN1 as the corrected 1-GPU run directory}"
: "${RUN2:?Export RUN2 as the corrected 2-GPU run directory}"
: "${RUN4:?Export RUN4 as the corrected 4-GPU run directory}"
: "${OPT_BASE:?Export OPT_BASE as the accumulation baseline run directory}"
: "${OPT_NOSYNC:?Export OPT_NOSYNC as the no_sync run directory}"
: "${RESULT_ROOT:=results/carc_final}"

mkdir -p "$RESULT_ROOT/scaling" "$RESULT_ROOT/optimization" "$RESULT_ROOT/runs"

python scripts/plot_results.py \
  "$RUN1" "$RUN2" "$RUN4" \
  --output-dir "$RESULT_ROOT/scaling"

python scripts/plot_results.py \
  "$OPT_BASE" "$OPT_NOSYNC" \
  --output-dir "$RESULT_ROOT/optimization"

copy_run() {
  local label="$1"
  local source="$2"
  local target="$RESULT_ROOT/runs/$label"
  mkdir -p "$target"
  cp "$source/config.yaml" "$target/"
  cp "$source/environment.json" "$target/"
  cp "$source/metrics.csv" "$target/"
  cp "$source/summary.json" "$target/"
  cp -R "$source/renders" "$target/"
}

copy_run scaling_1gpu "$RUN1"
copy_run scaling_2gpu "$RUN2"
copy_run scaling_4gpu "$RUN4"
copy_run optimization_baseline "$OPT_BASE"
copy_run optimization_nosync "$OPT_NOSYNC"

cat > "$RESULT_ROOT/manifest.txt" <<EOF
Generated by Slurm job: $SLURM_JOB_ID
Generated at: $(date --iso-8601=seconds)
Scaling 1 GPU: $RUN1
Scaling 2 GPU: $RUN2
Scaling 4 GPU: $RUN4
Optimization baseline: $OPT_BASE
Optimization no_sync: $OPT_NOSYNC
EOF

tar -czf "${RESULT_ROOT}.tar.gz" "$RESULT_ROOT"
echo "GitHub-ready results: $RESULT_ROOT"
echo "Archive: ${RESULT_ROOT}.tar.gz"
